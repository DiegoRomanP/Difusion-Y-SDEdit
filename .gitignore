# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Datos, pesos y resultados reales: nunca forman parte del código entregable.
# `data/*` y no `data/`: con el directorio excluido git no desciende y la
# negación es inalcanzable. La negación va DESPUÉS: gana el último patrón.
# Las particiones se versionan porque definen qué imágenes quedaron en test;
# regenerarlo en otra máquina movería al train imágenes que estaban en test.
data/*
!data/dataset_splits.json

runs/
reports/
.cache/
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/
.coverage
htmlcov/

# No versionar credenciales de Kaggle/Hugging Face.
.env
.env.*
kaggle.json
access_token
*.pt
*.pth
*.safetensors
*.zip


# Salida del script de generación local
run/output/
run/output_sdedit/

presentacion/
.playwright-mcp/
